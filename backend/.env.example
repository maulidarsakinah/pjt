PORT=3000
NODE_ENV=development
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
LOG_RETENTION_COUNT=30
SERVICE_NAME=pkl-api
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_CONNECT_STRING=your-db-host:1521/your-service-name
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_INCREMENT=1
DB_POOL_TIMEOUT=60
DB_STATEMENT_CACHE_SIZE=30
ORACLE_USE_THICK_MODE=true
ORACLE_CLIENT_LIB_DIR=C:\path\to\instantclient
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_ISSUER=pkl-api
JWT_AUDIENCE=pkl-api-users
REFRESH_TOKEN_SECRET=change-this-to-a-different-long-random-secret
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_AUDIENCE=pkl-api-refresh
REFRESH_COOKIE_NAME=hydrotrack_refresh
REFRESH_COOKIE_SECURE=true
# Set to true in any internet-facing environment (required in production)
TOKEN_REVOCATION_MAX_ITEMS=10000
ENABLE_DOCS=true
BODY_LIMIT=100kb
CORS_ORIGINS=
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AUTH_CACHE_TTL_SECONDS=30
AUTH_CACHE_MAX_ITEMS=5000
STATION_CACHE_TTL_SECONDS=300
STATION_CACHE_MAX_ITEMS=1000
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_MAX_ITEMS=5000
